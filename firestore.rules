rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Admin check function — purely database-driven, no hardcoded emails
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.token.email));
    }

    // Admins Collection
    match /admins/{email} {
      allow read: if request.auth != null && request.auth.token.email == email || isAdmin();
      allow write: if isAdmin();
    }

    // Fan wall messages
    match /fan_messages/{messageId} {
      allow read: if true;
      allow create: if request.resource.data.senderName is string 
                    && request.resource.data.message is string
                    && request.resource.data.message.size() <= 1000;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']);
      allow delete: if isAdmin();
    }

    // Site Stats (Love meter)
    match /site_stats/{statId} {
      allow read: if true;
      allow write: if true; // Keeping open for the increment love counter
    }

    // Gallery media items (v1 & v2)
    match /gallery_media/{mediaId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /gallery_media_v2/{mediaId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Fan Art
    match /fan_art/{artId} {
      allow read: if true;
      
      // Fan Art is created via secure backend API. Only admins can write directly via client SDK.
      allow create: if isAdmin();
      
      // Non-admins can only update 'likes'. Admins can update anything (like 'isFeatured').
      allow update: if (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])) || isAdmin();
      
      allow delete: if isAdmin();
    }

    // Business & Collaboration inquiries
    match /collaborations/{collabId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Live social metric snapshots
    match /social_snapshots/{snapshotId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Social Posts
    match /social_posts/{postId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Instagram embeds store only the public post URL.
    match /instagramPosts/{postId} {
      allow read: if true;
      allow create: if isAdmin()
                    && request.resource.data.keys().hasOnly(['postUrl', 'addedAt'])
                    && request.resource.data.postUrl is string;
      allow update: if isAdmin()
                    && request.resource.data.keys().hasOnly(['postUrl', 'addedAt'])
                    && request.resource.data.postUrl is string;
      allow delete: if isAdmin();
    }
  }
}
