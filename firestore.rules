rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Fan wall messages
    match /fan_messages/{messageId} {
      allow read: if true;
      allow create: if request.resource.data.senderName is string 
                    && request.resource.data.message is string
                    && request.resource.data.message.size() <= 1000;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']);
      allow delete: if false;
    }

    // Site Stats (Love meter)
    match /site_stats/{statId} {
      allow read: if true;
      allow write: if true;
    }

    // Gallery media items
    match /gallery_media/{mediaId} {
      allow read: if true;
      allow write: if true;
    }

    // Fan Art
    match /fan_art/{artId} {
      allow read: if true;
      allow write: if true;
    }

    // Business & Collaboration inquiries
    match /collaborations/{collabId} {
      allow create: if true;
      allow read, update, delete: if true;
    }

    // Live social metric snapshots
    match /social_snapshots/{snapshotId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
