rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Admin check function
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'safarser3@gmail.com';
    }

    // Fan wall messages
    match /fan_messages/{messageId} {
      allow read: if true;
      allow create: if request.resource.data.senderName is string 
                    && request.resource.data.message is string
                    && request.resource.data.message.size() <= 1000;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']);
      allow delete: if isAdmin();
    }

    // Site Stats (Love meter)
    match /site_stats/{statId} {
      allow read: if true;
      allow write: if true; // Keeping open for the increment love counter
    }

    // Gallery media items (v1 & v2)
    match /gallery_media/{mediaId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /gallery_media_v2/{mediaId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Fan Art
    match /fan_art/{artId} {
      allow read: if true;
      
      // Anyone can create if logged in, but they CANNOT set isFeatured to true themselves!
      allow create: if request.auth != null && 
              request.resource.data.keys().hasOnly([
                'id', 'title', 'artistName', 'artistHandle', 'category', 'size',
                'imageUrl', 'videoUrl', 'textEssay', 'description', 'submittedAt',
                'likes', 'isFeatured', 'status'
              ])
              && request.resource.data.id is string
              && request.resource.data.id.size() <= 80
              && request.resource.data.title is string
              && request.resource.data.title.size() <= 160
              && request.resource.data.artistName is string
              && request.resource.data.artistName.size() <= 120
              && request.resource.data.description is string
              && request.resource.data.description.size() <= 2000
              && (!request.resource.data.keys().hasAny(['imageUrl'])
                || (request.resource.data.imageUrl is string
                  && request.resource.data.imageUrl.size() <= 2048
                  && request.resource.data.imageUrl.matches('https://.*')))
              && (!request.resource.data.keys().hasAny(['videoUrl'])
                || (request.resource.data.videoUrl is string
                  && request.resource.data.videoUrl.size() <= 2048
                  && request.resource.data.videoUrl.matches('https://.*')))
              && (!request.resource.data.keys().hasAny(['textEssay'])
                || (request.resource.data.textEssay is string
                  && request.resource.data.textEssay.size() <= 5000))
              && (!request.resource.data.keys().hasAny(['isFeatured']) || request.resource.data.isFeatured == false || isAdmin())
              && request.resource.data.likes == 1;
      
      // Non-admins can only update 'likes'. Admins can update anything (like 'isFeatured').
      allow update: if (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])) || isAdmin();
      
      allow delete: if isAdmin();
    }

    // Business & Collaboration inquiries
    match /collaborations/{collabId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Live social metric snapshots
    match /social_snapshots/{snapshotId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Social Posts
    match /social_posts/{postId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Instagram embeds store only the public post URL.
    match /instagramPosts/{postId} {
      allow read: if true;
      allow create: if isAdmin()
                    && request.resource.data.keys().hasOnly(['postUrl', 'addedAt'])
                    && request.resource.data.postUrl is string;
      allow update: if isAdmin()
                    && request.resource.data.keys().hasOnly(['postUrl', 'addedAt'])
                    && request.resource.data.postUrl is string;
      allow delete: if isAdmin();
    }
  }
}
