rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // site_config is publicly readable - hero photos, social profiles, resilience content etc.
    match /site_config/{docId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'blmoon8724@gmail.com';
    }
    
    // Fan messages - anyone can read, authenticated users can write
    match /fan_messages/{docId} {
      allow read: if true;
      allow create: if true;
      allow update: if request.auth != null;
      allow delete: if request.auth != null && request.auth.token.email == 'blmoon8724@gmail.com';
    }
    
    // Gallery media - publicly readable
    match /gallery_media_v2/{docId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'blmoon8724@gmail.com';
    }
    
    // Social posts - publicly readable
    match /social_posts/{docId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'blmoon8724@gmail.com';
    }

    // Instagram posts - publicly readable
    match /instagramPosts/{docId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'blmoon8724@gmail.com';
    }

    // Site stats - publicly readable, incrementable
    match /site_stats/{docId} {
      allow read: if true;
      allow write: if true;
    }
    
    // Fan art submissions - publicly readable
    match /fan_art/{docId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && request.auth.token.email == 'blmoon8724@gmail.com';
    }
  }
}
