# =========================================================================
# ENVIRONMENT VARIABLES — Copy this file to .env and fill in your values
# NEVER commit .env to Git — it's in .gitignore
# =========================================================================

# ── SERVER-SIDE AI / MODERATION (never use VITE_ prefix for these) ──────
# NVIDIA NIM — primary AI moderation provider
NVIDIA_API_KEY=

# ── SOCIAL METRICS ────────────────────────────────────────────────────────
# Apify Actor token for Instagram live follower scraping
APIFY_API_TOKEN=

# X / Twitter API v2 Bearer Token
TWITTER_BEARER_TOKEN=

# ── CACHING ───────────────────────────────────────────────────────────────
# Redis / Upstash connection string for rate limiting & caching
REDIS_URL=

# ── CRON SECURITY ─────────────────────────────────────────────────────────
# Secret to protect /api/cron/* endpoints. Set this in Vercel env vars too.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# ── FIRESTORE (optional override) ─────────────────────────────────────────
FIRESTORE_PROJECT_ID=gen-lang-client-0250984123
FIRESTORE_DATABASE_ID=ai-studio-shubhashreesahuf-b7597c00-ccb8-4efe-93b3-07b8951f4efc

# ── FRONTEND PUBLIC VARS (VITE_ prefix = baked into browser bundle) ────────
# Only put NON-SECRET values here!
# Cloudflare Worker URL for fan art uploads (safe — it's a public endpoint)
VITE_CLOUDFLARE_WORKER_URL=https://fan-art-upload.safarser3.workers.dev


# Content moderation: the service tries providers in this order:
#   Gemini -> OpenAI -> DeepSeek -> NVIDIA -> local regex fallback
# At least one AI key is recommended; the local regex catches obvious vulgar content.

# Gemini (Google AI Studio)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OpenAI / OpenAI-compatible endpoint
VITE_OPENAI_API_KEY=""
VITE_OPENAI_ENDPOINT=""  # defaults to https://api.openai.com/v1/chat/completions
VITE_OPENAI_MODEL=""     # defaults to gpt-4o-mini

# DeepSeek (cheap, fast, good moderation)
VITE_DEEPSEEK_API_KEY=""

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APIFY_API_TOKEN: Optional API token for Apify Actor Instagram / Social Scraper
APIFY_API_TOKEN=

# TWITTER_BEARER_TOKEN: Optional Twitter / X API v2 Bearer Token
TWITTER_BEARER_TOKEN=

# REDIS_URL: Optional Upstash/Redis connection string for high-speed caching
REDIS_URL=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_CLOUDFLARE_WORKER_URL: URL to the Cloudflare Worker handling R2 Fan Art uploads
VITE_CLOUDFLARE_WORKER_URL="https://fan-art-upload.safarser3.workers.dev"
